{
  "name": "parliament-rumble-prototype",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-runtime.mjs",
    "dev": "node scripts/sync-runtime.mjs && tsx server.ts",
    "start": "node scripts/sync-runtime.mjs && node server.ts",
    "build": "node scripts/sync-runtime.mjs && node -e \"import('node:fs').then(async fs=>{if(fs.existsSync('app-source/assets/challenge/arena-v2.png'))await import('./build-release-output.mjs');})\"",
    "test": "node scripts/sync-runtime.mjs && node --test --test-force-exit tests/*.test.mjs",
    "optimize:assets": "node scripts/optimize-assets.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.2.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
